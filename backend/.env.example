# Telnyx — legacy single-аккаунт (используется только пока во вкладке
# "Telnyx" в админке не добавлен ни один аккаунт; после добавления хотя бы
# одного аккаунта эти переменные больше не используются)
TELNYX_API_KEY=KEY_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELNYX_CONNECTION_ID=1234567890
TELNYX_WEBHOOK_PUBLIC_KEY=

# VPN/прокси для запросов к Telnyx API (чекбокс во вкладке "Telnyx",
# по умолчанию выключен). Без одной из этих переменных чекбокс задизейблен.
# Приоритет: TELNYX_PROXY_URL → WEBSHARE_PROXY_* → HTTPS_PROXY/HTTP_PROXY
TELNYX_PROXY_URL=
# Webshare — удобный способ задать прокси без ручной сборки URL
# (логин/пароль берутся из https://dashboard.webshare.io/proxy/settings)
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
WEBSHARE_PROXY_HOST=
WEBSHARE_PROXY_PORT=
WEBSHARE_PROXY_COUNTRY=
WEBSHARE_PROXY_ROTATE=

# DIDWW (провижининг номеров, без программных звонков — см. doc/DIDWW_SETUP.md)
DIDWW_API_KEY=
DIDWW_ENVIRONMENT=sandbox

# DIDLogic (провижининг номеров, требует ручного указания конкретного номера — см. doc/DIDLOGIC_SETUP.md)
DIDLOGIC_API_KEY=

# Публичный URL этого бэкенда (нужен, чтобы Telnyx мог дозвониться до
# вебхука звонка и скачать mp3 из Vercel Blob для playback_start)
PUBLIC_BACKEND_URL=https://your-backend.vercel.app

# ElevenLabs (генерация озвучки)
VOICE_API_KEY=
VOICE_ID=EXAVITQu4vr4xnSDxMaL
VOICE_MODEL=eleven_flash_v2_5

# Vercel Blob (публичное хранение сгенерированных mp3)
BLOB_READ_WRITE_TOKEN=

# Database (Supabase Postgres pooled connection)
DATABASE_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"

# Admin auth (email + password)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
# сгенерировать: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=$2a$10$replace-with-bcrypt-hash

# Admin auth (Google Sign-In)
# Client ID из Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs (тип "Web application")
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Список Gmail-адресов, которым разрешён вход, через запятую
ALLOWED_GMAIL_EMAILS=you@gmail.com,partner@gmail.com

# Admin + клиентская страница auth (Telegram Login Widget)
# Токен бота — @BotFather → /mybots → выбрать бота → API Token.
# Один и тот же бот используется и в админке, и на клиентской странице —
# см. doc/TELEGRAM_LOGIN_SETUP.md про /setdomain и создание бота.
TELEGRAM_BOT_TOKEN=
# Список числовых Telegram ID через запятую, которым разрешён вход В АДМИНКУ
# (свой узнать можно через @userinfobot). На клиентской странице такого
# ограничения нет — Telegram-вход туда открыт всем, как и Google.
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Клиентская страница "/" (логин через Google, БЕЗ ограничения по
# ALLOWED_GMAIL_EMAILS — GOOGLE_CLIENT_ID переиспользуется тот же, что выше)
# Cron-диспетчер отложенных/интервальных кампаний обзвона — см.
# doc/CLIENT_PAGE_SETUP.md про ограничения Vercel Cron на Hobby-плане
CRON_SECRET=

PORT=3000
