# ==============================================================================
# ВАЖНО: используется ТОЛЬКО docker-compose для локальной отладки.
# Продовый билд фронтенда для Vercel (frontend/vercel.json) идёт своим путём
# (`vite build` в рамках обычного Vercel-деплоя без Docker) — этот файл
# на него никак не влияет.
# ==============================================================================

FROM node:20-alpine AS dev
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
