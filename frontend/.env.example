# Единый деплой (см. корневой vercel.json) — фронтенд и бэкенд на одном
# домене, оставить ПУСТЫМ (запросы идут относительным путём /api/...).
# Указать явно (например http://localhost:3000) только при локальной
# разработке БЕЗ Docker, когда backend поднят отдельным процессом на своём
# порту — см. README, "Быстрый старт", вариант 2.
VITE_API_URL=

VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Username бота БЕЗ @ (например MyCallerIdBot) — см. doc/TELEGRAM_LOGIN_SETUP.md
VITE_TELEGRAM_BOT_USERNAME=
